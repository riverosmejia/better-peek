diff --git a/ui-tui/src/lib/openLocalPath.ts b/ui-tui/src/lib/openLocalPath.ts
new file mode 100644
index 00000000000..ea9000ffd48
--- /dev/null
+++ b/ui-tui/src/lib/openLocalPath.ts
@@ -0,0 +1,108 @@
+import { spawn, type SpawnOptions } from 'node:child_process'
+
+/**
+ * Running the user's own opener, and showing a path in their file manager.
+ *
+ * `PEEK_OPEN` is a command template, run through `/bin/sh -c`, with `{file}` and
+ * `{line}` substituted:
+ *
+ *   PEEK_OPEN='tmux new-window nano {file} +{line}'
+ *   PEEK_OPEN='code -g {file}:{line}'
+ *
+ * The path comes from the model's text, so it is single-quoted (with its own
+ * quotes escaped) before it reaches the template: it can never turn into a
+ * second command.
+ *
+ * With no template, a click shows the path in the file manager, the file
+ * selected: `org.freedesktop.FileManager1` (the standard way, what Dolphin,
+ * Nautilus, Thunar and Nemo all answer) and, if that service is not there or
+ * says no, its folder with `xdg-open`.
+ *
+ * Both return false when nothing could be started. The caller then shows the
+ * file inside the TUI — the answer that works with no display, no clipboard and
+ * no desktop, and the only one that tells the reader something happened.
+ */
+export type LocalOpenDependencies = {
+  spawn?: typeof spawn
+  env?: NodeJS.ProcessEnv
+}
+
+export function openWithUserCommand(
+  path: string,
+  line: number | undefined,
+  dependencies: LocalOpenDependencies = {}
+): boolean {
+  const spawnFn = dependencies.spawn ?? spawn
+  const env = dependencies.env ?? process.env
+  const template = env.PEEK_OPEN?.trim()
+
+  if (!template) {
+    return false
+  }
+
+  const command = template.replaceAll('{file}', quoted(path)).replaceAll('{line}', String(line ?? 1))
+
+  return detached(spawnFn, '/bin/sh', ['-c', command])
+}
+
+/** Shows the path in the desktop's file manager, the file selected. */
+export function revealInFileManager(path: string, dependencies: LocalOpenDependencies = {}): boolean {
+  const spawnFn = dependencies.spawn ?? spawn
+  const env = dependencies.env ?? process.env
+
+  // No display, no file manager: over ssh the click belongs to the TUI, which is the
+  // one answer that works there. That is the whole point of returning false.
+  if (!env.DISPLAY && !env.WAYLAND_DISPLAY) {
+    return false
+  }
+
+  const url = `file://${encodeURI(path)}`
+  const folder = path.slice(0, path.lastIndexOf('/')) || '/'
+
+  try {
+    const child = spawnFn(
+      'dbus-send',
+      [
+        '--session',
+        '--print-reply',
+        '--dest=org.freedesktop.FileManager1',
+        '/org/freedesktop/FileManager1',
+        'org.freedesktop.FileManager1.ShowItems',
+        `array:string:${url}`,
+        ''
+      ],
+      { stdio: 'ignore' }
+    )
+
+    // A service that answers "no" (or is not there) leaves the folder to xdg-open.
+    child.once('error', () => {
+      detached(spawnFn, 'xdg-open', [folder])
+    })
+    child.once('exit', code => {
+      if (code !== 0) {
+        detached(spawnFn, 'xdg-open', [folder])
+      }
+    })
+
+    return true
+  } catch {
+    return detached(spawnFn, 'xdg-open', [folder])
+  }
+}
+
+/** Starts something and lets it go; false when the binary is not there. */
+function detached(spawnFn: typeof spawn, command: string, args: string[]): boolean {
+  try {
+    const child = spawnFn(command, args, { detached: true, stdio: 'ignore' } satisfies SpawnOptions)
+
+    child.once('error', () => {})
+    child.unref()
+
+    return true
+  } catch {
+    return false
+  }
+}
+
+/** One argument for the sh template: single quotes, its own quotes escaped. */
+const quoted = (value: string) => `'${value.replaceAll("'", "'\\''")}'`
