+import { NoSelect, Text, useStdout } from '@hermes/ink'
+import { useStore } from '@nanostores/react'
+import { memo, useMemo } from 'react'
+
+import { cardPosition } from '../lib/pathCardPosition.js'
+import { $pathHover } from '../lib/pathHover.js'
+import { bodyOf } from '../lib/pathPreview.js'
+import { highlightLine } from '../lib/syntax.js'
+import type { Theme } from '../theme.js'
+
+/**
+ * The card a path answers a hover with: what the file is, what a click does, and
+ * its lines around the one the path named, coloured by the same highlighter the
+ * transcript uses for its code blocks.
+ *
+ * It sits at the cell the pointer entered the link on (ink hands that over with
+ * the hover), one row below the link when there is room and above it when there
+ * is not, and clamped to the screen so it never runs off an edge.
+ *
+ * It must have a backgroundColor: without one its empty cells are never written,
+ * the transcript underneath keeps its OSC 8 hyperlink, and the hover highlight
+ * overlay — which runs after the frame is painted — inverts those cells back on
+ * top of the card.
+ */
+const MIN_WIDTH = 60
+const MAX_WIDTH = 100
+const ROWS = 12
+
+export const PathCard = memo(function PathCard({ t }: { t: Theme }) {
+  const hover = useStore($pathHover)
+  const { stdout } = useStdout()
+  const cols = stdout?.columns ?? 80
+  const screenRows = stdout?.rows ?? 24
+
+  const body = useMemo(
+    () => (hover ? bodyOf(hover.path, hover.line, ROWS) : null),
+    [hover]
+  )
+
+  // The transcript already showed the path: the card names the file, not the whole directory.
+  const name = hover ? (hover.path.slice(hover.path.lastIndexOf('/') + 1) || hover.path) : ''
+  const title = hover?.line === undefined ? name : `${name}:${hover?.line}`
+
+  const action = body?.numbered === false ? 'click: list the folder' : 'click: show in folder'
+
+  const header = body
+    ? body.note ?? `${title}${body.meta ? ` · ${body.meta}` : ''}${body.note ? '' : ` · ${action}`}`
+    : ''
+
+  const width = Math.max(MIN_WIDTH, Math.min(MAX_WIDTH, header.length + 4, cols - 4))
+
+  if (!body) {
+    return null
+  }
+
+  const trunk = body.lines.length > 0 ? body.lines : []
+  const { left, top } = cardPosition(hover ?? undefined, { width, height: trunk.length + 3 }, { cols, rows: screenRows })
+
+  return (
+    <NoSelect
+      backgroundColor={t.color.completionBg}
+      borderColor={t.color.border}
+      borderStyle="round"
+      flexDirection="column"
+      left={left}
+      paddingX={1}
+      position="absolute"
+      top={top}
+      width={width}
+    >
+      <Text color={body.note ? t.color.warn : t.color.accent} wrap="truncate-end">
+        {header}
+      </Text>
+      {trunk.map(({ number, text, mark }) => (
+        <Text key={number} wrap="truncate-end">
+          <Text color={mark ? t.color.accent : t.color.muted}>
+            {body.numbered ? `${mark ? '▸' : ' '}${String(number).padStart(5)}  ` : '  '}
+          </Text>
+          {highlightLine(text, body.lang, t).map(([color, token], index) => (
+            <Text color={color || t.color.label} key={index}>
+              {token}
+            </Text>
+          ))}
+        </Text>
+      ))}
+    </NoSelect>
+  )
+})
