index 00000000000..4a0f05f00d9
--- /dev/null
+++ b/ui-tui/src/lib/pathCardPosition.ts
@@ -0,0 +1,28 @@
+/**
+ * Where the hover card goes: at the cell the pointer entered the link on, one gap
+ * below it when there is room and above it when there is not, clamped so it never
+ * runs off an edge. Pure so it can be checked without rendering the terminal.
+ */
+export type CardAnchor = { col?: number; row?: number } | undefined
+export type CardBox = { width: number; height: number }
+export type Screen = { cols: number; rows: number }
+
+export const CARD_GAP = 2
+
+export function cardPosition(anchor: CardAnchor, box: CardBox, screen: Screen, gap = CARD_GAP) {
+  if (anchor?.col === undefined || anchor.row === undefined) {
+    return {
+      left: Math.max(0, screen.cols - box.width - 1),
+      top: Math.max(0, screen.rows - box.height - 1)
+    }
+  }
+
+  const anchorCol = anchor.col
+  const anchorRow = anchor.row
+
+  const left = Math.max(0, Math.min(anchorCol - gap, screen.cols - box.width))
+  const fits = anchorRow + gap + box.height <= screen.rows
+  const top = Math.max(0, fits ? anchorRow + gap : anchorRow - box.height - 1)
+
+  return { left, top }
+}
