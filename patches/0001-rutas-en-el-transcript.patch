@@ -0,0 +1,58 @@
+import { spawn, type SpawnOptions } from 'node:child_process'
+
+/**
+ * Runs the user's own opener for a clicked path, when they configured one.
+ *
+ * `PEEK_OPEN` is a command template, run through `/bin/sh -c`, with `{file}` and
+ * `{line}` substituted:
+ *
+ *   PEEK_OPEN='tmux new-window nano {file} +{line}'
+ *   PEEK_OPEN='code -g {file}:{line}'
+ *
+ * The path comes from the model's text, so it is single-quoted (with its own
+ * quotes escaped) before it reaches the template: it can never turn into a
+ * second command.
+ *
+ * Returns false when there is no template, or the spawn threw. The caller then
+ * shows the file inside the TUI — the answer that works with no display, no
+ * clipboard and no editor, and the only one that tells the reader something
+ * happened.
+ */
+export type LocalOpenDependencies = {
+  spawn?: typeof spawn
+  env?: NodeJS.ProcessEnv
+}
+
+export function openWithUserCommand(
+  path: string,
+  line: number | undefined,
+  dependencies: LocalOpenDependencies = {}
+): boolean {
+  const spawnFn = dependencies.spawn ?? spawn
+  const env = dependencies.env ?? process.env
+  const template = env.PEEK_OPEN?.trim()
+
+  if (!template) {
+    return false
+  }
+
+  const command = template.replaceAll('{file}', quoted(path)).replaceAll('{line}', String(line ?? 1))
+
+  try {
+    const child = spawnFn('/bin/sh', ['-c', command], {
+      detached: true,
+      stdio: 'ignore'
+    } satisfies SpawnOptions)
+
+    // A missing binary must not crash the TUI; the caller falls back to the pager.
+    child.once('error', () => {})
+    child.unref()
+
+    return true
+  } catch {
+    return false
+  }
+}
+
+/** One argument for the sh template: single quotes, its own quotes escaped. */
+const quoted = (value: string) => `'${value.replaceAll("'", "'\\''")}'`
