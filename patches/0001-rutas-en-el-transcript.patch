diff --git a/ui-tui/src/__tests__/pathCard.test.tsx b/ui-tui/src/__tests__/pathCard.test.tsx
new file mode 100644
index 00000000000..1b6924a65e1
--- /dev/null
+++ b/ui-tui/src/__tests__/pathCard.test.tsx
@@ -0,0 +1,102 @@
+import { writeFileSync } from 'fs'
+import { PassThrough } from 'stream'
+
+import { Box, renderSync } from '@hermes/ink'
+import { stripAnsi } from '@hermes/shared/ansi'
+import React from 'react'
+import { afterEach, describe, expect, it } from 'vitest'
+
+import { PathCard } from '../components/pathCard.js'
+import { $pathHover } from '../lib/pathHover.js'
+import { bodyOf } from '../lib/pathPreview.js'
+import { DEFAULT_THEME } from '../theme.js'
+
+const renderCard = (columns = 120): { frame: string[]; raw: string } => {
+  const stdout = new PassThrough()
+  const stdin = new PassThrough()
+  const stderr = new PassThrough()
+  let output = ''
+
+  Object.assign(stdout, { columns, isTTY: false, rows: 40 })
+  Object.assign(stdin, { isTTY: false })
+  Object.assign(stderr, { isTTY: false })
+  stdout.on('data', (chunk: Buffer) => {
+    output += chunk.toString()
+  })
+
+  const instance = renderSync(
+    <Box flexDirection="column" height={40} width={columns}>
+      <PathCard t={DEFAULT_THEME} />
+    </Box>,
+    {
+      patchConsole: false,
+      stderr: stderr as unknown as NodeJS.WriteStream,
+      stdin: stdin as unknown as NodeJS.ReadStream,
+      stdout: stdout as unknown as NodeJS.WriteStream
+    }
+  )
+
+  instance.unmount()
+  instance.cleanup()
+
+  return {
+    frame: stripAnsi(output)
+      .split('\n')
+      .map(line => line.replace(/\s+$/, '')),
+    raw: output
+  }
+}
+
+
+
+describe('PathCard', () => {
+  afterEach(() => {
+    $pathHover.set(null)
+  })
+
+  it('says what the file is and what a click does', () => {
+    $pathHover.set({ path: `${process.cwd()}/package.json`, row: 4, col: 10 })
+
+    expect(renderCard().frame.join('\n')).toContain('package.json · 47 lines · click: show in folder')
+  })
+
+  it('shows the named line, marked, with its number', () => {
+    $pathHover.set({ path: `${process.cwd()}/package.json`, line: 3, row: 4, col: 10 })
+
+    const frame = renderCard().frame.join('\n')
+
+    expect(frame).toContain('package.json:3')
+    expect(frame).toContain('▸')
+    expect(frame).toContain('"version": "0.0.1"')
+  })
+
+  it('picks the highlighter by the file extension', () => {
+    writeFileSync('/tmp/cardtest/sample.txt', 'export const answer = 42\n')
+    $pathHover.set({ path: '/tmp/cardtest/sample.ts', line: 1, row: 4, col: 10 })
+
+    expect(renderCard().frame.join('\n')).toContain('export const answer = 42')
+    expect(bodyOf('/tmp/cardtest/sample.ts').lang).toBe('ts')
+    expect(bodyOf('/tmp/cardtest/sample.txt').lang).toBe('')
+  })
+
+  it('lists a folder without pretending its names are line numbers', () => {
+    $pathHover.set({ path: `${process.cwd()}/src/lib`, row: 4, col: 10 })
+
+    const frame = renderCard().frame.join('\n')
+
+    expect(frame).toContain('directory,')
+    expect(frame).toContain('click: list the folder')
+    expect(frame).toContain('pathPreview.ts')
+    expect(frame).not.toMatch(/\s1 {2}pathPreview\.ts/)
+  })
+
+  it('draws nothing when the pointer is not on a path', () => {
+    expect(renderCard().frame.join('\n').trim()).toBe('')
+  })
+
+  it('says why, instead of lines, when the file is missing', () => {
+    $pathHover.set({ path: '/nope/does-not-exist.ts', row: 4, col: 10 })
+
+    expect(renderCard().frame.join('\n')).toContain('cannot read it')
+  })
+})
