+//
+// shortcut: relative paths resolve from the TUI process's folder, not from the
+// session's own after a `cd`; upgrade by reading the session cwd from the store
+// when someone hits it.
+const renderProse = (key: number, text: string): ReactNode => {
+  const hits = text ? existingPaths(text) : []
+
+  if (!hits.length) {
+    return <Text key={key}>{text}</Text>
