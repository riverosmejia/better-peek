+++ b/ui-tui/src/lib/pathPeek.ts
@@ -0,0 +1,21 @@
+import { atom } from 'nanostores'
+
+/**
+ * What a click on a path in an answer asked to see.
+ *
+ * The click cannot do anything the terminal can show by itself: there is no
+ * pointer position for a card, no clipboard that works over ssh, and handing the
+ * file to an editor would take the screen away mid-turn. So the click leaves a
+ * request here and the app answers it — the same pager the `/help` panels use.
+ */
+export type PathPeek = { path: string; line?: number }
+
+export const $pathPeek = atom<PathPeek | null>(null)
+
+export const requestPathPeek = (path: string, line?: number): void => {
+  $pathPeek.set({ path, ...(line === undefined ? {} : { line }) })
+}
+
+export const clearPathPeek = (): void => {
+  $pathPeek.set(null)
+}
diff --git a/ui-tui/src/lib/pathPreview.ts b/ui-tui/src/lib/pathPreview.ts
new file mode 100644
index 00000000000..372270c76c2
--- /dev/null
+++ b/ui-tui/src/lib/pathPreview.ts
@@ -0,0 +1,117 @@
+import { readdirSync, readFileSync, statSync } from 'node:fs'
+
+/**
+ * What a path shows when you look at it: the file it names, its lines around the
+ * one the path named, and enough about it to know what you are looking at.
+ *
+ * Two consumers, one reading: the pager a click opens (plain text, numbered) and
+ * the card a hover shows (the same lines, coloured). Everything that can go wrong
+ * (gone, unreadable, binary, enormous, a folder) comes back as a note that says
+ * so — a click always answers.
+ */
+
+const MAX_BYTES = 2 * 1024 * 1024
+const MAX_DIR_ENTRIES = 200
+const CONTEXT = 10
+
+/** Extension to the language names `syntax.ts` knows, so the card can colour the lines. */
+const LANGS: Record<string, string> = {
+  bash: 'sh', cjs: 'ts', cts: 'ts', go: 'go', js: 'ts', json: 'json', jsonc: 'json',
+  jsx: 'ts', mjs: 'ts', mts: 'ts', py: 'py', pyi: 'py', rs: 'rust', sh: 'sh',
+  sql: 'sql', ts: 'ts', tsx: 'ts', yaml: 'yaml', yml: 'yaml', zsh: 'sh'
+}
+
+export type PreviewLine = { number: number; text: string; mark: boolean }
+
+export type PreviewBody = {
+  /** `src/app.ts:42`, or `src/` for a folder. */
+  title: string
+  /** `49 lines`, `directory, 12 entries`. */
+  meta: string
+  /** The lines to show. Empty when `note` explains why there is nothing. */
+  lines: PreviewLine[]
+  /** Whether the lines are numbered (a file) or just names (a folder). */
+  numbered: boolean
+  /** Why there is nothing to show, when there is nothing. */
+  note?: string
+  /** The language name `syntax.ts` takes, or '' for plain. */
+  lang: string
+}
+
+export function bodyOf(path: string, line?: number, rows = 60): PreviewBody {
+  try {
+    const stat = statSync(path)
+
+    if (stat.isDirectory()) {
+      const entries = readdirSync(path).sort()
+
+      return {
+        title: `${path}/`,
+        meta: `directory, ${entries.length} entries`,
+        lines: entries.slice(0, MAX_DIR_ENTRIES).map(name => ({ number: 0, text: name, mark: false })),
+        numbered: false,
+        lang: ''
+      }
+    }
+
+    const kb = Math.round(stat.size / 1024)
+
+    if (stat.size > MAX_BYTES) {
+      return { title: path, meta: '', lines: [], numbered: true, note: `(too large to show: ${kb}k)`, lang: '' }
+    }
+
+    const text = readFileSync(path, 'utf8')
+
+    if (text.slice(0, 4096).includes('\0')) {
+      return { title: path, meta: '', lines: [], numbered: true, note: `(binary file, ${kb}k)`, lang: '' }
+    }
+
+    const all = text.split('\n')
+
+    // A file that ends in a newline gains an empty last line that is not one.
+    if (all.length > 1 && all.at(-1) === '') {
+      all.pop()
+    }
+
+    const mark = line !== undefined && line >= 1 && line <= all.length ? line : 0
+    const first = mark > 0 ? Math.max(1, mark - CONTEXT) : 1
+    const extension = path.slice(path.lastIndexOf('.') + 1).toLowerCase()
+
+    return {
+      title: `${path}${mark > 0 ? `:${mark}` : ''}`,
+      meta: `${all.length} lines`,
+      numbered: true,
+      lang: LANGS[extension] ?? '',
+      lines: all.slice(first - 1, first - 1 + rows).map((row, offset) => {
+        const number = first + offset
+
+        return { number, text: row.replaceAll('\t', '  ').trimEnd(), mark: number === mark }
+      })
+    }
+  } catch (error) {
+    return {
+      title: path,
+      meta: '',
+      lines: [],
+      numbered: true,
+      note: `(cannot read it: ${(error as Error).message})`,
+      lang: ''
+    }
+  }
+}
+
+/** The same, as the plain text the pager shows: numbered, the named line marked. */
+export function pathPreview(path: string, line?: number, rows = 60): string {
+  const body = bodyOf(path, line, rows)
+
+  if (body.note) {
+    return `${body.title}\n${body.note}`
+  }
+
+  return [
+    `${body.title}  ·  ${body.meta}`,
+    ...body.lines.map(({ number, text, mark }) =>
+      body.numbered ? `${mark ? '▸' : ' '}${String(number).padStart(5)}  ${text}` : `  ${text}`
+    )
+  ].join('\n')
+}
diff --git a/ui-tui/src/lib/paths.ts b/ui-tui/src/lib/paths.ts
new file mode 100644
index 00000000000..caa1ddba663
--- /dev/null
+++ b/ui-tui/src/lib/paths.ts
@@ -0,0 +1,249 @@
+import { existsSync, statSync } from 'node:fs'
+import { homedir } from 'node:os'
+
+/**
+ * Finding the paths a text names, and which of them lead somewhere.
+ *
+ * Port of `hooks/paths.ts` from midudev's quick-peek (MIT) to the
+ * TUI, so a path in an answer can become a link instead of staying plain text.
+ * The rules are the original's: absolute, from home, relative, bare, each with
+ * an optional `:line` or `:line:col`; addresses are never paths.
+ */
+
+export type Found = { start: number; end: number; target: string }
+
+/** A path that leads somewhere: where it sits in the text, as written, resolved, and its line. */
+export type PathHit = { start: number; end: number; label: string; path: string; line?: number }
+
+// What a sentence puts after a path, and a line (and column) after a file.
+const TRAILING = /[.,;:!?)\]}>'"»”’]+$/
+const LINE = /:\d+(?::\d+)?$/
+// An address: never a path, nor the paths inside it.
+const URL_RE = /\b[a-z][a-z0-9+.-]*:\/\/[^\s<>()]+/gi
+
+// Absolute, from home or explicitly relative; a relative path with a folder in
+// it; a file name with an extension. None starts inside a word, an address or
+// another path.
+const SOURCES = [
+  String.raw`(?:~|\.{1,2})?/[^\s\`'"<>()[\]{}|*]+`,
+  String.raw`[A-Za-z]:\\[^\s\`'"<>()[\]{}|*]+`,
+  String.raw`[\w@+-][\w@.+-]*(?:/[\w@.+-]+)+/?`,
+  String.raw`[\w@+-][\w@.+-]*\.[A-Za-z][A-Za-z0-9]{0,9}`
+]
+
+const CANDIDATE = new RegExp(SOURCES.map(src => String.raw`(?<![\w/.~:\\@-])(?:${src})(?::\d+(?::\d+)?)?`).join('|'), 'g')
+// A whole inline code span that is a path: it may hold spaces when it starts as
+// a path does.
+const SPAN = /^(?:(?:~|\.{1,2})?\/|[A-Za-z]:\\)[^\n`]*[^\s`]$/
+
+/** The line a path's text names after it (`src/x.ts:12`, `src/x.ts:12:5`), if any. */
+export function lineOf(text: string): number | undefined {
+  const line = text.trim().replace(TRAILING, '').match(LINE)?.[0]
+
+  return line === undefined ? undefined : Number(line.slice(1).split(':')[0])
+}
+
+function clean(text: string): string | undefined {
+  let target = text.replace(TRAILING, '')
+
+  target = target.replace(LINE, '')
+  target = target.replace(TRAILING, '')
+
+  return /[\w~]/.test(target) && target !== '~' ? target : undefined
+}
+
+/** The paths named in plain text, in order. */
+export function pathsIn(text: string): Found[] {
+  const masked = text.replace(URL_RE, match => ' '.repeat(match.length))
+  const found: Found[] = []
+
+  for (const match of masked.matchAll(CANDIDATE)) {
+    const whole = match[0]
+    const target = clean(whole)
+
+    if (target === undefined) {
+      continue
+    }
+
+    found.push({ start: match.index ?? 0, end: (match.index ?? 0) + whole.replace(TRAILING, '').length, target })
+  }
+
+  return found
+}
+
+/** The path an inline code span holds whole (`~/a b/c.mp4`), if it holds one. */
+export function pathOfSpan(code: string): string | undefined {
+  const text = code.trim()
+
+  if (SPAN.test(text)) {
+    return text.replace(LINE, '')
+  }
+
+  const found = pathsIn(text)
+
+  return found.length === 1 && found[0]!.start === 0 && found[0]!.end === text.length ? found[0]!.target : undefined
+}
+
+/** Where `target` lands: home for `~`, `cwd` for a relative path; `.`/`..` folded. */
+export function resolvePath(target: string, cwd: string, home: string | undefined): string | undefined {
+  if (/^[A-Za-z]:\\/.test(target)) {
+    return target
+  }
+
+  let path = target
+
+  if (path === '~' || path.startsWith('~/')) {
+    if (!home) {
+      return undefined
+    }
+
+    path = home + path.slice(1)
+  } else if (!path.startsWith('/')) {
+    path = `${cwd}/${path}`
+  }
+
+  const parts: string[] = []
+
+  for (const part of path.split('/')) {
+    if (part === '' || part === '.') {
+      continue
+    }
+
+    if (part === '..') {
+      parts.pop()
+    } else {
+      parts.push(part)
+    }
+  }
+
+  return `/${parts.join('/')}`
+}
+
+// A stat is not free and the same answer is asked every frame a message
+// re-renders: what exists is remembered longer than what is missing (a file
+// created a moment ago must show up soon).
+const FOUND_MS = 30_000
+const MISSING_MS = 3_000
+const stats = new Map<string, { at: number; there: boolean }>()
+
+function there(path: string): boolean {
+  const now = Date.now()
+  const known = stats.get(path)
+
+  if (known && now - known.at < (known.there ? FOUND_MS : MISSING_MS)) {
+    return known.there
+  }
+
+  let found = false
+
+  try {
+    found = statSync(path).isFile() || statSync(path).isDirectory()
+  } catch {
+    found = false
+  }
+
+  if (stats.size > 2000) {
+    stats.clear()
+  }
+
+  stats.set(path, { at: now, there: found })
+
+  return found
+}
+
+/**
+ * The paths of `text` that lead to a file or a folder, in the order they appear,
+ * deduplicated. A relative path leads from the folder the shell is in.
+ */
+export function existingPaths(text: string, cwd: string = process.cwd(), home = homedir(), limit = 20): PathHit[] {
+  // A path written as a whole code span may hold spaces (`~/My Videos/a b.mp4`), so the spans are
+  // read first and then the plain text; both together, in the order they appear.
+  const named: Found[] = []
+
+  for (const span of text.matchAll(/`([^\n`]+)`/g)) {
+    const code = span[1] ?? ''
+    const target = pathOfSpan(code)
+    const start = (span.index ?? 0) + 1
+
+    if (target !== undefined) {
+      named.push({ start, end: start + code.length, target })
+    }
+  }
+
+  named.push(...pathsIn(text))
+  named.sort((a, b) => a.start - b.start)
+
+  const hits: PathHit[] = []
+  const seen = new Set<string>()
+
+  for (const found of named) {
+    const path = resolvePath(found.target, cwd, home)
+
+    if (!path || seen.has(path) || !there(path)) {
+      continue
+    }
+
+    seen.add(path)
+
+    const line = lineOf(text.slice(found.start, found.end))
+
+    hits.push({
+      start: found.start,
+      end: found.end,
+      label: text.slice(found.start, found.end),
+      path,
+      ...(line === undefined ? {} : { line })
+    })
+
+    if (hits.length >= limit) {
+      break
+    }
+  }
+
+  return hits
+}
+
+/**
+ * The link a path in prose carries. A scheme of our own, so a `file://` a model
+ * writes in markdown keeps being refused by `parseSafeUrl` — only links this
+ * renderer built can reach the local-click handler.
+ */
+export const PEEK_SCHEME = 'hermes-peek:'
+
+export const fileUrl = (path: string, line?: number): string =>
+  `${PEEK_SCHEME}//${path.split('/').map(encodeURIComponent).join('/')}${line === undefined ? '' : `#L${line}`}`
+
+/** The local path a `file://` URL names, and the line its fragment holds. */
+export function localPathOf(url: URL): { path: string; line?: number } {
+  const path = decodeURIComponent(url.pathname)
+  const line = Number(url.hash.replace(/^#L/, ''))
+
+  return { path, ...(Number.isFinite(line) && line > 0 ? { line } : {}) }
+}
+
+/** Whether a path is something we are willing to hand to a click handler. */
+export const isLocalFile = (path: string): boolean =>
+  path.startsWith('/') && !path.includes('\0') && existsSync(path)
+
+/**
+ * The path a whole inline code span names, when it leads somewhere:
+ * `` `src/app.ts:42` ``, `` `~/My Videos/a b.mp4` ``. Answers are written mostly
+ * with paths inside backticks, so this is the shape that matters most.
+ */
+export function codeSpanPath(code: string, cwd: string = process.cwd(), home = homedir()): PathHit | undefined {
+  const target = pathOfSpan(code)
+
+  if (target === undefined) {
+    return undefined
+  }
+
+  const path = resolvePath(target, cwd, home)
+
+  if (!path || !there(path)) {
+    return undefined
+  }
+
+  const line = lineOf(code)
+
+  return { start: 0, end: code.length, label: code, path, ...(line === undefined ? {} : { line }) }
+}
