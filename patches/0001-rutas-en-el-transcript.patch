+import { mkdirSync, mkdtempSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+import { describe, expect, it } from 'vitest'
+
+import { localUrl, openExternalUrl, parseSafeUrl } from '../lib/openExternalUrl.js'
+import { openWithUserCommand } from '../lib/openLocalPath.js'
+import { $pathHover, setHoveredLink } from '../lib/pathHover.js'
+import { $pathPeek, clearPathPeek } from '../lib/pathPeek.js'
+import { pathPreview } from '../lib/pathPreview.js'
+import { codeSpanPath, existingPaths, fileUrl, lineOf, localPathOf, pathOfSpan, pathsIn, resolvePath } from '../lib/paths.js'
+
+const found = (text: string) => pathsIn(text).map(f => [text.slice(f.start, f.end), f.target])
+
+// The cases the original ships (plugins/quick-peek/hooks/register.test.tsx:70-84) are the contract
+// of this port; the rest covers what the TUI adds on top: which paths lead somewhere, and what a
+// click on one does.
+describe('pathsIn', () => {
+  it('finds absolute, home, relative and bare paths, and cuts what a sentence adds', () => {
+    expect(found('Lo dejé en /Users/ana/x.mp4. Y en ~/notas.md, ¿vale?')).toEqual([
+      ['/Users/ana/x.mp4', '/Users/ana/x.mp4'],
+      ['~/notas.md', '~/notas.md']
+    ])
+    expect(found('Mira src/app.ts:42 y README.md (la raíz).')).toEqual([
+      ['src/app.ts:42', 'src/app.ts'],
+      ['README.md', 'README.md']
+    ])
+    expect(found('see https://example.com/a/b.html and/or 1/2')).toEqual([
+      ['and/or', 'and/or'],
+      ['1/2', '1/2']
+    ])
+    expect(found('a word, then this')).toEqual([])
+  })
+
+  it('reads a span whole, with spaces, and the line after a path', () => {
+    expect(pathOfSpan('~/My Videos/a b.mp4')).toBe('~/My Videos/a b.mp4')
+    expect(pathOfSpan('npm run build')).toBeUndefined()
+    expect(lineOf('src/app.ts:42')).toBe(42)
+    expect(lineOf('src/app.ts:42:7.')).toBe(42)
+    expect(lineOf('src/app.ts')).toBeUndefined()
+  })
+
+  it('folds dots and expands home', () => {
+    expect(resolvePath('../b/./c.txt', '/project/app', '/Users/ana')).toBe('/project/b/c.txt')
+    expect(resolvePath('~/x', '/project/app', '/Users/ana')).toBe('/Users/ana/x')
+    expect(resolvePath('~/x', '/project/app', undefined)).toBeUndefined()
+  })
+})
+
+describe('existingPaths', () => {
+  const root = mkdtempSync(join(tmpdir(), 'peek-'))
+  const app = join(root, 'app')
+  const home = join(root, 'home')
+
+  mkdirSync(join(app, 'src'), { recursive: true })
+  mkdirSync(join(home, 'My Videos'), { recursive: true })
+  writeFileSync(join(app, 'README.md'), '# hola\n')
+  writeFileSync(join(app, 'src', 'app.ts'), 'const a = 1\n')
+  writeFileSync(join(home, 'My Videos', 'a b.mp4'), 'x')
+
+  it('keeps only what exists, in order, deduplicated, with its line', () => {
+    const text = `mira ${app}/README.md y src/app.ts:1 y otra vez ${app}/README.md, y nada.mp4`
+    expect(existingPaths(text, app, home).map(hit => [hit.path, hit.line])).toEqual([
+      [`${app}/README.md`, undefined],
+      [`${app}/src/app.ts`, 1]
+    ])
+  })
+
+  it('resolves a relative path from the folder it is given', () => {
+    // From `src`, `src/app.ts` would be `src/src/app.ts`, which is not there; from the app it is.
+    expect(existingPaths('en src/app.ts', join(app, 'src'), home)).toEqual([])
+    expect(existingPaths('en src/app.ts', app, home).map(hit => hit.path)).toEqual([`${app}/src/app.ts`])
+  })
+
+  it('reads a span that holds a space', () => {
+    const hits = existingPaths('en `~/My Videos/a b.mp4` esta', app, home)
+    expect(hits.map(hit => [hit.label, hit.path])).toEqual([['~/My Videos/a b.mp4', join(home, 'My Videos', 'a b.mp4')]])
+  })
+
+  it('links a whole code span that is a path, which is how answers name files', () => {
+    // The write-up shape: `path` between backticks, not prose.
+    expect(codeSpanPath(`${app}/README.md`, app, home)).toMatchObject({ path: `${app}/README.md` })
+    expect(codeSpanPath('src/app.ts:1', app, home)).toMatchObject({ path: `${app}/src/app.ts`, line: 1 })
+    // Anything that is not only a path stays plain code.
+    expect(codeSpanPath('npm run build', app, home)).toBeUndefined()
+    expect(codeSpanPath('/no/existe.ts', app, home)).toBeUndefined()
+  })
+
+  it('drops addresses and missing files, and stops at the limit', () => {
+    const text = 'https://example.com/a/b.html y /no/existe/x.ts y src/app.ts y README.md'
+    expect(existingPaths(text, app, home).map(hit => hit.label)).toEqual(['src/app.ts', 'README.md'])
+    expect(existingPaths(text, app, home, 1)).toHaveLength(1)
+  })
+})
+
+describe('file urls', () => {
+  it('round-trips a path with spaces and accents, and keeps the line', () => {
+    const path = '/home/ana/Mis Vídeos/a b.mp4'
+    const hit = localPathOf(new URL(fileUrl(path, 42)))
+    expect(hit.path).toBe(path)
+    expect(hit.line).toBe(42)
+  })
+})
+
+describe('localUrl', () => {
+  const root = mkdtempSync(join(tmpdir(), 'peek-url-'))
+  const file = join(root, 'x.ts')
+  writeFileSync(file, 'x\n')
+
+  it('accepts only an existing local file under its own scheme, and never an address', () => {
+    expect(localUrl(fileUrl(file, 3))).toEqual({ path: file, line: 3 })
+    expect(localUrl(fileUrl(join(root, 'no.ts')))).toBeNull()
+    expect(localUrl('https://example.com/x')).toBeNull()
+    expect(localUrl('javascript:alert(1)')).toBeNull()
+    // A `file://` the model wrote itself never reaches the local handler.
+    expect(localUrl('file:///etc/passwd')).toBeNull()
+    expect(parseSafeUrl('file:///etc/passwd')).toBeNull()
+  })
+})
+
+describe('a click on a path', () => {
+  const calls: { command: string; args: readonly string[] }[] = []
+
+  const fakeSpawn = ((command: string, args: readonly string[]) => {
+    calls.push({ command, args })
+
+    return { once: () => {}, unref: () => {}, stdin: { end: () => {} } }
+  }) as never
+
+  const root = mkdtempSync(join(tmpdir(), 'peek-click-'))
+  const file = join(root, 'click.ts')
+  writeFileSync(file, 'a\nb\nc\n')
+
+  it('asks the TUI to show the file when no opener is configured', () => {
+    clearPathPeek()
+    calls.length = 0
+    expect(openExternalUrl(fileUrl(file, 2), { spawn: fakeSpawn, platform: () => 'linux' })).toBe(true)
+    expect($pathPeek.get()).toEqual({ path: file, line: 2 })
+    expect(calls).toHaveLength(0)
+  })
+
+  it('runs the user template through sh, with the path quoted, when PEEK_OPEN is set', () => {
+    calls.length = 0
+    expect(openWithUserCommand("/a/it's here.ts", 7, { spawn: fakeSpawn, env: { PEEK_OPEN: 'nano {file} +{line}' } })).toBe(true)
+    expect(calls[0]?.command).toBe('/bin/sh')
+    expect(calls[0]?.args[1]).toBe("nano '/a/it'\\''s here.ts' +7")
+  })
+
+  it('does nothing at all for a URL the model wrote itself', () => {
+    clearPathPeek()
+    expect(openExternalUrl('file:///etc/passwd')).toBe(false)
+    expect($pathPeek.get()).toBeNull()
+  })
+})
+
+describe('a hovered path', () => {
+  it('becomes the state only for a link this app built', () => {
+    const root = mkdtempSync(join(tmpdir(), 'peek-hover-'))
+    const file = join(root, 'h.ts')
+    writeFileSync(file, 'x\n')
+
+    $pathHover.set(null)
+    setHoveredLink(fileUrl(file, 9))
+    expect($pathHover.get()).toEqual({ path: file, line: 9 })
+
+    // The same link, cell after cell, is not news.
+    setHoveredLink(fileUrl(file, 9))
+    expect($pathHover.get()).toEqual({ path: file, line: 9 })
+
+    // An address is not a file to preview, and leaving the link clears it.
+    setHoveredLink('https://example.com/x.ts')
+    expect($pathHover.get()).toBeNull()
+
+    setHoveredLink(fileUrl(file))
+    setHoveredLink(undefined)
+    expect($pathHover.get()).toBeNull()
+  })
+})
+
+describe('pathPreview', () => {
+  const root = mkdtempSync(join(tmpdir(), 'peek-preview-'))
+  const file = join(root, 'p.ts')
+
+  writeFileSync(file, 'one\ntwo\nthree\n\tfour\nfive\n')
+
+  it('numbers the lines and marks the one the path named', () => {
+    const text = pathPreview(file, 3)
+
+    expect(text.split('\n')[0]).toBe(`${file}:3  ·  5 lines`)
+    expect(text).toContain('▸    3  three')
+    expect(text).toContain('     4    four')
+  })
+
+  it('answers for a folder, a missing path and a binary', () => {
+    expect(pathPreview(root)).toContain('directory')
+    expect(pathPreview(join(root, 'nope.ts'))).toContain('cannot read it')
+
+    const binary = join(root, 'b.bin')
+    writeFileSync(binary, 'a\0b')
+    expect(pathPreview(binary)).toContain('binary')
+  })
+})
