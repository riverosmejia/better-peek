new file mode 100644
index 00000000000..2e669dd9781
--- /dev/null
+++ b/ui-tui/src/lib/pathHover.ts
@@ -0,0 +1,45 @@
+import { atom } from 'nanostores'
+
+import { localPathOf, PEEK_SCHEME } from './paths.js'
+
+/** The path the pointer is on, if any, and the cell it entered on. */
+export type PathHoverState = { path: string; line?: number; col?: number; row?: number } | null
+
+export const $pathHover = atom<PathHoverState>(null)
+
+/**
+ * The renderer already knows this — it inverts a link's cells when the pointer
+ * is over it — and hands it over through `onHyperlinkHover` (wired in entry.tsx),
+ * with the cell the pointer entered on so the card can sit next to it.
+ *
+ * Only links this app built (`hermes-peek://`) become a state here: an address
+ * the model wrote is not a file to preview.
+ */
+export function setHoveredLink(
+  url: string | undefined,
+  position?: { col: number; row: number }
+): void {
+  if (!url || !url.startsWith(PEEK_SCHEME)) {
+    if ($pathHover.get() !== null) {
+      $pathHover.set(null)
+    }
+
+    return
+  }
+
+  try {
+    const { path, line } = localPathOf(new URL(url))
+    const current = $pathHover.get()
+
+    // Moving along one link fires on every cell: only a different file is news. The cell we
+    // entered on is part of that first event, and it is not updated while the pointer slides
+    // along the same link — otherwise every cell would re-render the card.
+    if (current?.path === path && current.line === line) {
+      return
+    }
+
+    $pathHover.set({ path, line, col: position?.col, row: position?.row })
+  } catch {
+    $pathHover.set(null)
+  }
+}
